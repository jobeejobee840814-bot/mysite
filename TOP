(function() {
  const tagSelect = $('tagSelect'), msgList = $('msgList');
  const nickInput = $('msgNick'), contentInput = $('msgContent'), sendBtn = $('sendMsgBtn');
  const TAGS = [
    { name: '左航', color: '#4FC3F7' }, { name: '张泽禹', color: '#69F0AE' },
    { name: '朱志鑫', color: '#FFD54F' }, { name: '张极', color: '#FFAB91' },
    { name: '苏新皓', color: '#FF6B81' }, { name: '全员', color: '#CE93D8' }
  ];
  let selectedTag = '全员';
  TAGS.forEach(t => {
    const chip = document.createElement('div');
    chip.className = 'tag-chip' + (t.name === selectedTag ? ' active' : '');
    chip.textContent = t.name; chip.style.borderColor = t.color;
    if (t.name === selectedTag) { chip.style.background = t.color; chip.style.color = '#1A0533'; }
    chip.addEventListener('click', () => {
      selectedTag = t.name;
      $$('.tag-chip', tagSelect).forEach(c => {
        c.classList.remove('active');
        c.style.background = 'rgba(255,255,255,0.08)';
        c.style.color = 'rgba(255,255,255,0.7)';
      });
      chip.classList.add('active'); chip.style.background = t.color; chip.style.color = '#1A0533';
    });
    tagSelect.appendChild(chip);
  });
  function load() { try { return JSON.parse(localStorage.getItem('top_messages') || '[]'); } catch(e) { return []; } }
  function save(l) { localStorage.setItem('top_messages', JSON.stringify(l)); }
  function tagColor(n) { const t = TAGS.find(x => x.name === n); return t ? t.color : '#CE93D8'; }
  function fmt(ts) {
    const d = new Date(ts), now = new Date(), diff = now - d;
    if (diff < 60000) return '刚刚';
    if (diff < 3600000) return Math.floor(diff/60000) + ' 分钟前';
    if (diff < 86400000) return Math.floor(diff/3600000) + ' 小时前';
    return `${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
  }
  function esc(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
  function render() {
    const list = load(); msgList.innerHTML = '';
    if (!list.length) { msgList.innerHTML = '<div class="empty-tip">还没有留言，来写第一条吧 🦋</div>'; return; }
    list.slice().reverse().forEach(msg => {
      const card = document.createElement('div');
      card.className = 'msg-card glass';
      card.innerHTML = `
        <div class="msg-head">
          <span class="msg-nick">${esc(msg.nick)}</span>
          <span class="msg-tag" style="background:${tagColor(msg.tag)}">${esc(msg.tag)}</span>
        </div>
        <div class="msg-content">${esc(msg.content)}</div>
        <div class="msg-foot">
          <span>${fmt(msg.time)}</span>
          <button class="like-btn ${msg.liked ? 'liked' : ''}">${msg.liked ? '❤️' : '🤍'} ${msg.likes}</button>
        </div>`;
      card.querySelector('.like-btn').addEventListener('click', () => {
        const all = load(); const t = all.find(m => m.id === msg.id); if (!t) return;
        if (t.liked) { t.likes = Math.max(0, t.likes - 1); t.liked = false; }
        else { t.likes++; t.liked = true; }
        save(all); render();
      });
      msgList.appendChild(card);
    });
  }
  sendBtn.addEventListener('click', () => {
    const nick = nickInput.value.trim() || '匿名蝴蝶';
    const content = contentInput.value.trim();
    if (!content) { showToast('写点什么再发送吧 🦋'); return; }
    const list = load();
    list.push({ id: Date.now() + '_' + Math.random().toString(36).slice(2,8), nick, content, tag: selectedTag, time: Date.now(), likes: 0, liked: false });
    save(list); contentInput.value = ''; render(); showToast('留言已送达 🦋');
  });
  const su = localStorage.getItem('top_user'); if (su) nickInput.value = su;
  render();
})();

// 五小登之家
(function() {
  const room = $('room'), stickmanLayer = $('stickmanLayer'), bedroom = $('bedroom');
  const diningTable = $('diningTable'), eatBtn = $('eatBtn'), fridge = $('fridge');
  const ROOM_W = 700, ROOM_H = 560;

  const bedPos = [
    { left: 10, top: 10, r: -3 }, { left: 120, top: 30, r: 2 }, { left: 230, top: 10, r: -2 },
    { left: 40, top: 90, r: 3 }, { left: 170, top: 110, r: -1 }
  ];
  const bedCols = ['#4FC3F7', '#69F0AE', '#FFD54F', '#FFAB91', '#FF6B81'];
  bedPos.forEach((p, i) => {
    const bed = document.createElement('div'); bed.className = 'bed';
    bed.style.left = p.left + 'px'; bed.style.top = p.top + 'px';
    bed.style.transform = `rotate(${p.r}deg)`;
    bed.innerHTML = `<div class="pillow"></div><div class="blanket" style="background:${bedCols[i]}"></div>`;
    bedroom.appendChild(bed);
    const ns = document.createElement('div'); ns.className = 'bed-nightstand';
    ns.style.left = (p.left + 105) + 'px'; ns.style.top = (p.top + 20) + 'px';
    ns.style.transform = `rotate(${p.r}deg)`;
    bedroom.appendChild(ns);
  });

  const stickmanData = [];
  MEMBERS.forEach((m, i) => {
    const el = document.createElement('div'); el.className = 'stickman';
    const x = 80 + Math.random() * (ROOM_W - 160);
    const y = 80 + Math.random() * (ROOM_H - 160);
    el.style.left = x + 'px'; el.style.top = y + 'px';
    el.innerHTML = `
      <div class="head" style="background:${m.color}"></div>
      <div class="body"></div>
      <div class="arm left"></div><div class="arm right"></div>
      <div class="leg left"></div><div class="leg right"></div>`;
    el.addEventListener('click', (e) => { e.stopPropagation(); bubble(el, MEMBER_DIALOGUES[m.name]); });
    stickmanLayer.appendChild(el);
    stickmanData.push({ el, x, y, name: m.name });
  });
  function bubble(el, text) {
    const o = el.querySelector('.bubble'); if (o) o.remove();
    const b = document.createElement('div'); b.className = 'bubble'; b.textContent = text;
    el.appendChild(b);
    clearTimeout(el._bt); el._bt = setTimeout(() => b.remove(), 2500);
  }
  function move(d) {
    const x = 30 + Math.random() * (ROOM_W - 80);
    const y = 30 + Math.random() * (ROOM_H - 80);
    d.x = x; d.y = y;
    d.el.style.left = x + 'px'; d.el.style.top = y + 'px';
  }
  function startMove(d) {
    function sched() {
      d._t = setTimeout(() => { if (!d._paused) move(d); sched(); }, 2000 + Math.random() * 4000);
    }
    sched();
  }
  stickmanData.forEach(startMove);

  fridge.addEventListener('click', () => {
    const ov = $('modalOverlay'), p = $('modalPanel');
    let h = '<h3>🧊 冰箱里的食材</h3><div class="food-grid">';
    FOOD_ITEMS.forEach((f, i) => h += `<div class="food-item" data-i="${i}"><span class="emoji">${f.emoji}</span><span class="fname">${f.name}</span></div>`);
    h += '</div><button class="modal-close">关闭</button>';
    p.innerHTML = h; ov.classList.add('show');
    p.querySelectorAll('.food-item').forEach(it => it.addEventListener('click', () => {
      const i = +it.dataset.i; showToast(FOOD_ITEMS[i].emoji + ' ' + FOOD_ITEMS[i].text);
    }));
    p.querySelector('.modal-close').addEventListener('click', () => ov.classList.remove('show'));
  });

  let served = [];
  diningTable.addEventListener('click', (e) => {
    e.stopPropagation();
    const ov = $('modalOverlay'), p = $('modalPanel');
    p.innerHTML = `<h3>🍽️ 上菜啦</h3><button class="serve-btn" id="serveBtn">开始上菜</button><div class="served-list" id="servedList"></div><button class="modal-close">关闭</button>`;
    ov.classList.add('show');
    const sl = p.querySelector('#servedList');
    function r() { sl.innerHTML = served.length ? served.map(d => `<span class="served-item">${d}</span>`).join('') : '<span style="color:rgba(255,255,255,0.3);font-size:13px">还没有上菜</span>'; }
    r();
    p.querySelector('#serveBtn').addEventListener('click', () => {
      if (served.length >= DISHES.length) { showToast('菜都上齐啦，开饭吧！🍚'); return; }
      const d = DISHES[served.length]; served.push(d); r(); addDish(d);
    });
    p.querySelector('.modal-close').addEventListener('click', () => ov.classList.remove('show'));
  });
  function addDish(name) {
    const d = document.createElement('div'); d.className = 'dish';
    const a = Math.random() * Math.PI * 2, rad = 20 + Math.random() * 25;
    d.style.left = (55 + Math.cos(a) * rad) + 'px';
    d.style.top = (40 + Math.sin(a) * rad) + 'px';
    d.textContent = name;
    if (diningTable) diningTable.appendChild(d);
  }

  let clicks = 0, ctimer = null;
  eatBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    clicks++; clearTimeout(ctimer); ctimer = setTimeout(() => clicks = 0, 3000);
    if (clicks >= 3) { showToast('别催了别催了正在跑来——'); return; }
    const tx = 420, ty = 310;
    const pos = [
      { x: tx - 60, y: ty - 50 }, { x: tx + 60, y: ty - 50 },
      { x: tx - 70, y: ty + 60 }, { x: tx + 70, y: ty + 60 },
      { x: tx, y: ty - 80 }
    ];
    stickmanData.forEach((d, i) => {
      d._paused = true; clearTimeout(d._t);
      const p = pos[i] || pos[0]; d.x = p.x; d.y = p.y;
      d.el.style.left = p.x + 'px'; d.el.style.top = p.y + 'px';
    });
    setTimeout(() => showToast('五个人到齐啦🦋'), 1800);
    setTimeout(() => {
      stickmanData.forEach(d => { d._paused = false; startMove(d); });
      clicks = 0;
    }, 8000);
  });

  room.addEventListener('click', (e) => {
    if (e.target === room) $$('.bubble', room).forEach(b => b.remove());
  });
})();

// 专注时钟
(function() {
  const to = $('timeOptions'), ci = $('customInput'), cm = $('customMin');
  const tn = $('timeNum'), tl = $('timeLabel'), td = $('timerDisplay');
  const sb = $('startTimerBtn'), rb = $('resetTimerBtn');
  const dt = $('dailyTotal'), qt = $('quoteText');
  let sel = 15, rem = 900, iv = null, run = false, ci2 = 0;
  const cols = MEMBERS.map(m => m.color);
  function key() { const d = new Date(); return `top_focus_${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`; }
  function total() { return parseInt(localStorage.getItem(key()) || '0', 10); }
  function add(m) { const k = key(); localStorage.setItem(k, String(parseInt(localStorage.getItem(k) || '0', 10) + m)); upTotal(); }
  function upTotal() { dt.textContent = `今日累计专注时长：${total()} 分钟`; }
  upTotal();
  to.querySelectorAll('.time-opt').forEach(o => {
    o.addEventListener('click', () => {
      if (run) { showToast('专注中，先重置再切换吧 🦋'); return; }
      to.querySelectorAll('.time-opt').forEach(x => x.classList.remove('active'));
      o.classList.add('active');
      const m = +o.dataset.min;
      if (m === 0) { ci.classList.add('show'); const v = +cm.value; sel = (v && v > 0) ? v : 25; cm.focus(); }
      else { ci.classList.remove('show'); sel = m; }
      rem = sel * 60; up(); tl.textContent = '准备开始';
    });
  });
  cm.addEventListener('input', () => {
    if (run) return; const v = +cm.value;
    if (v && v > 0) { sel = Math.min(v, 180); rem = sel * 60; up(); }
  });
  function up() {
    const m = Math.floor(rem / 60), s = rem % 60;
    tn.textContent = `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
  }
  function rgba(h, a) {
    const r = parseInt(h.slice(1,3),16), g = parseInt(h.slice(3,5),16), b = parseInt(h.slice(5,7),16);
    return `rgba(${r},${g},${b},${a})`;
  }
  function finish() {
    const ov = $('modalOverlay'), p = $('modalPanel');
    const q = QUOTES[Math.floor(Math.random() * QUOTES.length)];
    p.innerHTML = `<div class="finish-modal"><div class="emoji-big">🦋</div><h3>专注完成！</h3><div class="quote">${q}</div><button class="timer-btn primary" id="fc" style="width:100%">继续加油</button></div>`;
    ov.classList.add('show');
    p.querySelector('#fc').addEventListener('click', () => { ov.classList.remove('show'); reset(); });
  }
  function start() {
    if (run) return;
    if (rem <= 0) { rem = sel * 60; up(); }
    run = true; tl.textContent = '专注中...'; sb.textContent = '专注中';
    ci2 = 0; td.style.background = 'rgba(255,255,255,0.08)';
    iv = setInterval(() => {
      rem--; up();
      if (rem % 10 === 0) { ci2 = (ci2 + 1) % cols.length; td.style.background = rgba(cols[ci2], 0.15); }
      if (rem <= 0) { clearInterval(iv); run = false; sb.textContent = '开始专注'; tl.textContent = '完成！'; add(sel); finish(); }
    }, 1000);
  }
  function reset() {
    clearInterval(iv); run = false; rem = sel * 60; up();
    tl.textContent = '准备开始'; sb.textContent = '开始专注';
    td.style.background = 'rgba(255,255,255,0.08)';
  }
  sb.addEventListener('click', () => {
    if (run) { clearInterval(iv); run = false; sb.textContent = '继续专注'; tl.textContent = '已暂停'; }
    else start();
  });
  rb.addEventListener('click', reset);
  function rq() {
    const q = QUOTES[Math.floor(Math.random() * QUOTES.length)];
    qt.style.animation = 'none'; qt.offsetHeight;
    qt.textContent = q; qt.style.animation = 'quoteFade 0.6s ease-out';
  }
  rq(); setInterval(rq, 6000);
  up();
  $('modalOverlay').addEventListener('click', (e) => {
    if (e.target === $('modalOverlay')) $('modalOverlay').classList.remove('show');
  });
})();
// 星星瓶
(function() {
  const jarBody = $('jarBody');
  const starInput = $('starInput');
  const dropBtn = $('dropStarBtn');
  const clearBtn = $('clearJarBtn');
  const countEl = $('starCount');

  const STAR_EMOJIS = ['⭐', '🌟', '✨', '💫', '🌠'];

  function loadWishes() {
    try { return JSON.parse(localStorage.getItem('top_wishes') || '[]'); }
    catch (e) { return []; }
  }
  function saveWishes(list) {
    localStorage.setItem('top_wishes', JSON.stringify(list));
  }
  function escapeHtmlStar(s) {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  function render() {
    const wishes = loadWishes();
    jarBody.innerHTML = '';
    countEl.textContent = `瓶子里有 ${wishes.length} 颗星星`;

    wishes.forEach((w, i) => {
      const star = document.createElement('div');
      star.className = 'wish-star';
      star.textContent = STAR_EMOJIS[i % STAR_EMOJIS.length];
      star.style.left = (8 + Math.random() * 74) + '%';
      star.style.top = (8 + Math.random() * 74) + '%';
      star.style.animationDelay = (Math.random() * 3).toFixed(2) + 's';
      star.style.animationDuration = (2.5 + Math.random() * 2).toFixed(2) + 's';

      star.addEventListener('click', () => {
        const ov = $('modalOverlay');
        const p = $('modalPanel');
        const d = new Date(w.time);
        const timeStr = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
        p.innerHTML = `
          <h3>🌟 一颗星星的愿望</h3>
          <div style="font-size:15px;line-height:1.7;color:rgba(255,255,255,0.9);margin-bottom:14px;word-break:break-word;text-align:center;">“${escapeHtmlStar(w.content)}”</div>
          <div style="font-size:11px;color:rgba(255,255,255,0.4);text-align:center;margin-bottom:6px;">来自：${escapeHtmlStar(w.nick || '匿名蝴蝶')}</div>
          <div style="font-size:11px;color:rgba(255,255,255,0.3);text-align:center;">${timeStr}</div>
          <button class="modal-close">关闭</button>
        `;
        ov.classList.add('show');
        p.querySelector('.modal-close').addEventListener('click', () => ov.classList.remove('show'));
      });

      jarBody.appendChild(star);
    });
  }

  dropBtn.addEventListener('click', () => {
    const content = starInput.value.trim();
    if (!content) { showToast('写点什么再投进去吧 ✨'); return; }
    const nick = localStorage.getItem('top_user') || '匿名蝴蝶';
    const list = loadWishes();
    list.push({
      id: Date.now() + '_' + Math.random().toString(36).slice(2, 8),
      content: content,
      nick: nick,
      time: Date.now()
    });
    saveWishes(list);
    starInput.value = '';
    render();
    showToast('愿望已投进瓶子 🌟');
  });

  starInput.addEventListener('keydown', e => {
    if (e.key === 'Enter') dropBtn.click();
  });

  clearBtn.addEventListener('click', () => {
    const wishes = loadWishes();
    if (wishes.length === 0) { showToast('瓶子已经是空的啦'); return; }
    if (confirm('确定要清空瓶子里的所有星星吗？')) {
      localStorage.removeItem('top_wishes');
      render();
      showToast('瓶子已清空 🫧');
    }
  });

  render();
})();

