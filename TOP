<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>🦋 TOP 粉丝社区</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html, body {
  height: 100%;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  background: #0D0221; color: #fff; overflow: hidden; overscroll-behavior: none;
}
body { background: radial-gradient(ellipse at 50% 0%, #1A0533 0%, #0D0221 70%); position: relative; }

#stardust { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
.star {
  position: absolute; width: 2px; height: 2px; background: #fff; border-radius: 50%;
  opacity: 0; animation: twinkle 4s infinite ease-in-out; box-shadow: 0 0 4px rgba(255,255,255,0.6);
}
@keyframes twinkle { 0%,100%{opacity:0;transform:scale(0.6);} 50%{opacity:0.9;transform:scale(1.2);} }

.butterfly-watermark { position: fixed; pointer-events: none; opacity: 0.08; z-index: 1; }
.butterfly-watermark.tl { top: -20px; left: -20px; transform: rotate(-15deg); }
.butterfly-watermark.br { bottom: 60px; right: -20px; transform: rotate(165deg); }
.butterfly-watermark.tr { top: 10px; right: -30px; transform: rotate(25deg) scale(0.8); }
.butterfly-watermark.bl { bottom: 100px; left: -30px; transform: rotate(-160deg) scale(0.8); }

.glass {
  background: rgba(255,255,255,0.08);
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,0.12); border-radius: 16px;
}

/* ========== 登录页 ========== */
#loginPage {
  position: fixed; inset: 0; z-index: 100;
  display: flex; align-items: center; justify-content: center; padding: 24px;
  transition: opacity 0.5s, visibility 0.5s;
}
#loginPage.hidden { opacity: 0; visibility: hidden; pointer-events: none; }
.login-box { width: 100%; max-width: 360px; padding: 40px 28px 32px; text-align: center; animation: fadeUp 0.6s ease-out; }
@keyframes fadeUp { from{opacity:0;transform:translateY(24px);} to{opacity:1;transform:translateY(0);} }
.login-box h1 {
  font-size: 26px; font-weight: 700; margin-bottom: 6px;
  background: linear-gradient(135deg, #CE93D8, #9C27B0);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.login-box .sub { font-size: 12px; letter-spacing: 4px; color: rgba(206,147,216,0.6); margin-bottom: 32px; text-transform: uppercase; }
.login-box input {
  width: 100%; padding: 14px 16px; margin-bottom: 14px;
  background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15);
  border-radius: 12px; color: #fff; font-size: 15px; outline: none;
  transition: border-color 0.25s, background 0.25s;
}
.login-box input::placeholder { color: rgba(255,255,255,0.35); }
.login-box input:focus { border-color: #CE93D8; background: rgba(206,147,216,0.08); }
.login-btn {
  width: 100%; padding: 14px; margin-top: 8px; border: none; border-radius: 12px;
  background: linear-gradient(135deg, #7B1FA2, #CE93D8); color: #fff;
  font-size: 16px; font-weight: 600; cursor: pointer;
  transition: transform 0.2s, box-shadow 0.2s;
  box-shadow: 0 6px 20px rgba(123,31,162,0.4);
}
.login-btn:active { transform: scale(0.97); box-shadow: 0 3px 12px rgba(123,31,162,0.5); }
.login-error { color: #FF6B81; font-size: 13px; margin-top: 12px; min-height: 18px; opacity: 0; transition: opacity 0.25s; }
.login-error.show { opacity: 1; }

/* ========== 主应用 ========== */
#app { position: fixed; inset: 0; z-index: 10; display: none; flex-direction: column; }
#app.show { display: flex; }
#pages { flex: 1; overflow-y: auto; overflow-x: hidden; -webkit-overflow-scrolling: touch; padding-bottom: 80px; }
.page { display: none; animation: pageIn 0.35s ease-out; }
.page.active { display: block; }
@keyframes pageIn { from{opacity:0;transform:translateY(10px);} to{opacity:1;transform:translateY(0);} }
.page-header { padding: 28px 20px 16px; text-align: center; }
.page-header h2 { font-size: 22px; font-weight: 700; color: #E1BEE7; }
.page-header p { font-size: 12px; color: rgba(255,255,255,0.4); margin-top: 6px; letter-spacing: 1px; }

/* ========== 底部导航 ========== */
#navBar {
  position: fixed; bottom: 0; left: 0; right: 0; height: 64px; display: flex; z-index: 50;
  background: rgba(13,2,33,0.85);
  backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  border-top: 1px solid rgba(206,147,216,0.15);
  padding-bottom: env(safe-area-inset-bottom);
}
.nav-item {
  flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 3px; font-size: 10px; color: rgba(255,255,255,0.45);
  cursor: pointer; transition: color 0.25s; user-select: none;
}
.nav-item .icon { font-size: 20px; line-height: 1; }
.nav-item.active { color: #CE93D8; }
.nav-item.active .icon { filter: drop-shadow(0 0 8px rgba(206,147,216,0.6)); }

/* ========== 成员页 ========== */
.members-scroll {
  display: flex; gap: 16px; overflow-x: auto; padding: 8px 20px 24px;
  scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;
}
.members-scroll::-webkit-scrollbar { display: none; }
.flip-card { flex: 0 0 220px; height: 320px; perspective: 1000px; scroll-snap-align: center; cursor: pointer; }
.flip-inner {
  position: relative; width: 100%; height: 100%;
  transform-style: preserve-3d;
  transition: transform 0.7s cubic-bezier(0.4, 0.2, 0.2, 1);
}
.flip-card.flipped .flip-inner { transform: rotateY(180deg); }
.flip-face {
  position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden;
  border-radius: 16px; overflow: hidden;
  background: rgba(255,255,255,0.08);
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,0.12);
  display: flex; flex-direction: column;
}
.flip-front { align-items: center; justify-content: center; }
.flip-front .name {
  font-size: 38px; font-weight: 800; letter-spacing: 4px;
  writing-mode: vertical-rl; text-orientation: upright;
}
.flip-front .color-bar { position: absolute; bottom: 0; left: 0; right: 0; height: 8px; }
.flip-back { transform: rotateY(180deg); padding: 24px 20px; justify-content: center; gap: 14px; }
.flip-back .b-name { font-size: 26px; font-weight: 800; letter-spacing: 2px; }
.flip-back .b-tag {
  display: inline-block; padding: 4px 12px; border-radius: 20px;
  font-size: 12px; font-weight: 600; color: #1A0533; align-self: flex-start;
}
.flip-back .b-row { font-size: 13px; color: rgba(255,255,255,0.75); display: flex; gap: 8px; }
.flip-back .b-row .label { color: rgba(255,255,255,0.4); min-width: 48px; }

/* ========== 留言页 ========== */
.msg-form { margin: 0 20px 20px; padding: 20px; }
.msg-form input, .msg-form textarea {
  width: 100%; background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.12); border-radius: 10px;
  padding: 12px 14px; color: #fff; font-size: 14px; font-family: inherit;
  outline: none; margin-bottom: 12px; transition: border-color 0.25s;
}
.msg-form input::placeholder, .msg-form textarea::placeholder { color: rgba(255,255,255,0.3); }
.msg-form input:focus, .msg-form textarea:focus { border-color: #CE93D8; }
.msg-form textarea { resize: vertical; min-height: 80px; }
.tag-select { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
.tag-chip {
  padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 600;
  cursor: pointer; border: 2px solid transparent;
  background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.7);
  transition: all 0.2s;
}
.tag-chip.active { color: #1A0533; transform: scale(1.05); }
.send-btn {
  width: 100%; padding: 13px; border: none; border-radius: 10px;
  background: linear-gradient(135deg, #7B1FA2, #CE93D8); color: #fff;
  font-size: 15px; font-weight: 600; cursor: pointer; transition: transform 0.2s;
}
.send-btn:active { transform: scale(0.98); }
.msg-list { padding: 0 20px 20px; display: flex; flex-direction: column; gap: 12px; }
.msg-card { padding: 16px; position: relative; }
.msg-card .msg-head { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
.msg-card .msg-nick { font-size: 14px; font-weight: 600; color: #E1BEE7; }
.msg-card .msg-tag { font-size: 10px; padding: 2px 8px; border-radius: 10px; font-weight: 600; color: #1A0533; }
.msg-card .msg-content { font-size: 14px; line-height: 1.6; color: rgba(255,255,255,0.85); word-break: break-word; margin-bottom: 10px; }
.msg-card .msg-foot { display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: rgba(255,255,255,0.35); }
.like-btn {
  background: rgba(255,255,255,0.08); border: none; border-radius: 14px;
  padding: 5px 12px; color: rgba(255,255,255,0.6); font-size: 12px;
  cursor: pointer; transition: all 0.2s; display: flex; align-items: center; gap: 4px;
}
.like-btn:active { transform: scale(0.9); }
.like-btn.liked { background: rgba(255,107,129,0.2); color: #FF6B81; }
.empty-tip { text-align: center; padding: 40px 20px; color: rgba(255,255,255,0.25); font-size: 13px; }

/* ========== 五小登之家 ========== */
.room-wrap { padding: 0 16px 24px; overflow-x: auto; -webkit-overflow-scrolling: touch; }
.room {
  position: relative; width: 700px; height: 560px; margin: 0 auto;
  background: #FFF8E7; border: 5px solid #3E2723; border-radius: 18px;
  overflow: hidden; box-shadow: 0 10px 40px rgba(0,0,0,0.4);
}
.room::before {
  content: ''; position: absolute; inset: 0;
  background-image:
    repeating-linear-gradient(0deg, transparent, transparent 38px, rgba(62,39,35,0.08) 38px, rgba(62,39,35,0.08) 40px),
    repeating-linear-gradient(90deg, transparent, transparent 38px, rgba(62,39,35,0.08) 38px, rgba(62,39,35,0.08) 40px);
  pointer-events: none;
}
.zone-label {
  position: absolute; font-size: 13px; font-weight: 800; color: #3E2723;
  background: rgba(255,255,255,0.85); padding: 2px 10px;
  border: 3px solid #3E2723; border-radius: 12px; z-index: 5;
  font-family: 'Comic Sans MS', cursive; transform: rotate(-2deg);
}
.bedroom { position: absolute; left: 15px; bottom: 15px; width: 300px; height: 230px; }
.zone-label.bedroom-l { left: 20px; bottom: 235px; }
.bed {
  position: absolute; width: 100px; height: 60px;
  background: #B3E5FC; border: 4px solid #3E2723; border-radius: 10px;
}
.bed .pillow {
  position: absolute; top: 4px; left: 6px; width: 26px; height: 20px;
  background: #fff; border: 3px solid #3E2723; border-radius: 8px;
}
.bed .blanket { position: absolute; bottom: 4px; right: 6px; width: 55px; height: 30px; border-radius: 6px; opacity: 0.85; }
.bed-nightstand {
  position: absolute; width: 22px; height: 26px;
  background: #FFE082; border: 3px solid #3E2723; border-radius: 5px;
}
.kitchen { position: absolute; right: 15px; top: 15px; width: 280px; height: 210px; }
.zone-label.kitchen-l { right: 20px; top: 230px; }
.fridge {
  position: absolute; right: 10px; top: 10px; width: 60px; height: 110px;
  background: #E0F7FA; border: 4px solid #3E2723; border-radius: 8px;
  cursor: pointer; transition: transform 0.2s;
}
.fridge:active { transform: scale(0.95); }
.fridge .divider { position: absolute; top: 38px; left: 0; right: 0; height: 4px; background: #3E2723; }
.fridge .handle { position: absolute; right: 6px; top: 44px; width: 6px; height: 16px; background: #3E2723; border-radius: 3px; }
.stove {
  position: absolute; right: 85px; top: 60px; width: 70px; height: 60px;
  background: #F5F5F5; border: 4px solid #3E2723; border-radius: 6px;
}
.stove .burner {
  position: absolute; width: 18px; height: 18px;
  border: 3px solid #3E2723; border-radius: 50%; background: #FFCCBC;
}
.stove .burner:nth-child(1) { top: 6px; left: 6px; }
.stove .burner:nth-child(2) { top: 6px; right: 6px; }
.stove .burner:nth-child(3) { bottom: 6px; left: 6px; }
.stove .burner:nth-child(4) { bottom: 6px; right: 6px; }
.stove .knob { position: absolute; top: -12px; width: 8px; height: 8px; background: #3E2723; border-radius: 50%; }
.stove .knob.k1 { left: 10px; }
.stove .knob.k2 { right: 10px; }
.counter {
  position: absolute; right: 10px; top: 135px; width: 150px; height: 40px;
  background: #FFCC80; border: 4px solid #3E2723; border-radius: 6px;
}
.counter .pot {
  position: absolute; top: -14px; left: 20px; width: 30px; height: 18px;
  border: 3px solid #3E2723; border-radius: 0 0 12px 12px; background: #B0BEC5;
}
.counter .bowl {
  position: absolute; top: -8px; right: 20px; width: 22px; height: 12px;
  border: 3px solid #3E2723; border-radius: 0 0 10px 10px; background: #fff;
}
.cabinet {
  position: absolute; right: 10px; top: 10px; width: 55px; height: 30px;
  background: #A5D6A7; border: 4px solid #3E2723; border-radius: 6px; margin-right: 70px;
}
.dining { position: absolute; left: 330px; top: 240px; width: 220px; height: 180px; }
.zone-label.dining-l { left: 335px; top: 425px; }
.table {
  position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
  width: 110px; height: 80px; background: #D7A86E;
  border: 5px solid #3E2723; border-radius: 8px;
  cursor: pointer; z-index: 3; transition: transform 0.2s;
  background-image: repeating-linear-gradient(90deg, transparent, transparent 10px, rgba(62,39,35,0.15) 10px, rgba(62,39,35,0.15) 12px);
}
.table:active { transform: translate(-50%, -50%) scale(0.96); }
.chair { position: absolute; width: 22px; height: 22px; border: 4px solid #3E2723; border-radius: 5px; background: #FFAB91; }
.chair.c1 { left: 30px; top: 20px; }
.chair.c2 { right: 30px; top: 20px; }
.chair.c3 { left: 30px; bottom: 20px; }
.chair.c4 { right: 30px; bottom: 20px; }
.chair.c5 { left: 50%; top: -18px; transform: translateX(-50%); }
.eat-btn {
  position: absolute; left: 50%; bottom: -10px; transform: translateX(-50%);
  padding: 8px 22px; background: linear-gradient(135deg, #FF9800, #FF5722);
  border: 3px solid #3E2723; border-radius: 20px; color: #fff;
  font-size: 13px; font-weight: 800; cursor: pointer; z-index: 10;
  font-family: 'Comic Sans MS', cursive; box-shadow: 0 4px 0 #3E2723;
  transition: transform 0.1s, box-shadow 0.1s;
}
.eat-btn:active { transform: translateX(-50%) translateY(3px); box-shadow: 0 1px 0 #3E2723; }
.dish {
  position: absolute; padding: 3px 8px;
  background: #FFF3E0; border: 3px solid #3E2723; border-radius: 6px;
  font-size: 11px; font-weight: 700; color: #3E2723; z-index: 6;
  animation: dishPop 0.3s ease-out;
  font-family: 'Comic Sans MS', cursive; white-space: nowrap;
}
@keyframes dishPop { from{transform:scale(0) rotate(-20deg);opacity:0;} to{transform:scale(1) rotate(0);opacity:1;} }
.living { position: absolute; left: 15px; top: 15px; width: 280px; height: 200px; }
.zone-label.living-l { left: 20px; top: 220px; }
.sofa { position: absolute; left: 10px; top: 10px; width: 130px; height: 50px; border: 5px solid #3E2723; border-radius: 12px; background: #CE93D8; }
.sofa .sofa-side { position: absolute; left: -5px; top: 40px; width: 50px; height: 55px; border: 5px solid #3E2723; border-radius: 12px; background: #BA68C8; }
.sofa .cushion { position: absolute; width: 32px; height: 30px; border: 3px solid #3E2723; border-radius: 6px; background: #F8BBD0; }
.sofa .cushion.cu1 { top: 8px; left: 12px; }
.sofa .cushion.cu2 { top: 8px; right: 12px; }
.coffee-table { position: absolute; left: 160px; top: 30px; width: 80px; height: 45px; border: 4px solid #3E2723; border-radius: 6px; background: #FFE082; }
.practice { position: absolute; right: 15px; bottom: 15px; width: 300px; height: 220px; }
.zone-label.practice-l { right: 20px; bottom: 240px; }
.mirror { position: absolute; right: 15px; top: 15px; width: 70px; height: 140px; background: #ECEFF1; border: 5px solid #90A4AE; border-radius: 6px; box-shadow: inset 0 0 20px rgba(255,255,255,0.8); }
.barre { position: absolute; right: 100px; top: 30px; width: 120px; height: 6px; background: #8D6E63; border: 3px solid #3E2723; border-radius: 4px; }
.shoe { position: absolute; width: 18px; height: 10px; border: 3px solid #3E2723; border-radius: 4px 4px 8px 8px; }
.shoe.s1 { right: 40px; bottom: 25px; background: #FF6B81; }
.shoe.s2 { right: 65px; bottom: 20px; background: #4FC3F7; transform: rotate(12deg); }
.shoe.s3 { right: 100px; bottom: 30px; background: #69F0AE; }
.shoe.s4 { right: 130px; bottom: 22px; background: #FFD54F; transform: rotate(-8deg); }

.stickman {
  position: absolute; width: 30px; height: 50px; z-index: 20; cursor: pointer;
  transition: left 1.6s cubic-bezier(0.4, 0, 0.2, 1), top 1.6s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: auto;
}
.stickman .head { position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 16px; height: 16px; border-radius: 50%; border: 3px solid #3E2723; }
.stickman .body { position: absolute; top: 16px; left: 50%; transform: translateX(-50%); width: 3px; height: 18px; background: #3E2723; border-radius: 2px; }
.stickman .arm { position: absolute; top: 20px; left: 50%; width: 18px; height: 3px; background: #3E2723; border-radius: 2px; transform-origin: center; }
.stickman .arm.left { transform: translateX(-100%) rotate(25deg); }
.stickman .arm.right { transform: rotate(-25deg); }
.stickman .leg { position: absolute; top: 34px; left: 50%; width: 3px; height: 15px; background: #3E2723; border-radius: 2px; transform-origin: top; }
.stickman .leg.left { transform: translateX(-2px) rotate(15deg); }
.stickman .leg.right { transform: translateX(-2px) rotate(-15deg); }
.bubble {
  position: absolute; bottom: 55px; left: 50%; transform: translateX(-50%);
  background: #fff; color: #3E2723; border: 3px solid #3E2723; border-radius: 12px;
  padding: 6px 10px; font-size: 12px; font-weight: 700; white-space: nowrap;
  z-index: 30; font-family: 'Comic Sans MS', cursive; animation: bubbleIn 0.3s ease-out;
  pointer-events: none;
}
.bubble::after { content: ''; position: absolute; bottom: -10px; left: 50%; transform: translateX(-50%); border: 6px solid transparent; border-top-color: #3E2723; }
@keyframes bubbleIn { from{opacity:0;transform:translateX(-50%) scale(0.7);} to{opacity:1;transform:translateX(-50%) scale(1);} }

/* ========== 弹窗 ========== */
.modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(4px); z-index: 200; display: none; align-items: center; justify-content: center; padding: 24px; }
.modal-overlay.show { display: flex; }
.modal-panel { width: 100%; max-width: 380px; max-height: 70vh; overflow-y: auto; padding: 24px; animation: fadeUp 0.3s ease-out; }
.modal-panel h3 { font-size: 18px; margin-bottom: 16px; color: #E1BEE7; text-align: center; }
.modal-close { display: block; width: 100%; margin-top: 16px; padding: 12px; border: none; border-radius: 10px; background: rgba(255,255,255,0.1); color: #fff; font-size: 14px; cursor: pointer; }
.food-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.food-item { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 12px 4px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; cursor: pointer; transition: all 0.2s; }
.food-item:active { transform: scale(0.92); background: rgba(206,147,216,0.15); }
.food-item .emoji { font-size: 26px; }
.food-item .fname { font-size: 11px; color: rgba(255,255,255,0.7); }
.serve-btn { width: 100%; padding: 14px; border: none; border-radius: 12px; background: linear-gradient(135deg, #FF9800, #FF5722); color: #fff; font-size: 15px; font-weight: 700; cursor: pointer; margin-bottom: 14px; }
.served-list { display: flex; flex-wrap: wrap; gap: 8px; }
.served-item { padding: 6px 14px; background: rgba(255,243,224,0.15); border: 1px solid rgba(255,183,77,0.3); border-radius: 16px; font-size: 13px; color: #FFB74D; }

/* ========== Toast ========== */
#toast {
  position: fixed; left: 50%; bottom: 100px; transform: translateX(-50%) translateY(20px);
  background: rgba(206,147,216,0.95); color: #1A0533; padding: 12px 24px; border-radius: 24px;
  font-size: 14px; font-weight: 700; z-index: 300; opacity: 0; pointer-events: none;
  transition: opacity 0.3s, transform 0.3s; white-space: nowrap;
  box-shadow: 0 8px 24px rgba(206,147,216,0.4);
}
#toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* ========== 专注时钟 ========== */
.quote-scroller { margin: 0 20px 16px; padding: 10px 16px; overflow: hidden; white-space: nowrap; font-size: 13px; color: #CE93D8; text-align: center; }
#quoteText { display: inline-block; animation: quoteFade 0.6s ease-out; }
@keyframes quoteFade { from{opacity:0;transform:translateY(8px);} to{opacity:1;transform:translateY(0);} }
.timer-section { display: flex; flex-direction: column; align-items: center; padding: 0 20px 24px; }
.time-options { display: flex; gap: 10px; margin-bottom: 24px; flex-wrap: wrap; justify-content: center; }
