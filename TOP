.jar { position: relative; width: 220px; height: 300px; }
.jar-lid { position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 110px; height: 28px; background: linear-gradient(135deg, #CE93D8, #9C27B0); border-radius: 10px 10px 4px 4px; box-shadow: 0 4px 12px rgba(206,147,216,0.4); z-index: 3; }
